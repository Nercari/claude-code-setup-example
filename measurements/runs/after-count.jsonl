n    def tearDown(self):\n        self.dir.cleanup()\n\n    def run_cli(self, *argv):\n        out = io.StringIO()\n        code = cli.main([\"--db\", self.db, *argv], out=out)\n        return code, out.getvalue()\n\n    def test_add_then_list(self):\n        self.assertEqual(self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"4\")[0], 0)\n        code, text = self.run_cli(\"list\")\n        self.assertEqual(code, 0)\n        self.assertIn(\"A-1\\tWidget\\t4\", text)\n\n    def test_add_twice_sums(self):\n        self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"2\")\n        _, text = self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"3\")\n        self.assertIn(\"5 in stock\", text)\n\n    def test_remove_too_much_fails(self):\n        self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"1\")\n        code, _ = self.run_cli(\"remove\", \"A-1\", \"--qty\", \"5\")\n        self.assertEqual(code, 1)\n\n    def test_remove_unknown_fails(self):\n        self.assertEqual(self.run_cli(\"remove\", \"ZZ\")[0], 1)\n\n\nclass StorageTests(unittest.TestCase):\n    def test_load_missing_file_is_empty(self):\n        self.assertEqual(storage.load(\"/nonexistent/shelf.json\"), {})\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","structuredPatch":[{"oldStart":38,"oldLines":11,"newStart":38,"newLines":27,"lines":["     def test_remove_unknown_fails(self):","         self.assertEqual(self.run_cli(\"remove\", \"ZZ\")[0], 1)"," ","+    def test_count_counts_distinct_items(self):","+        self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"2\")","+        self.run_cli(\"add\", \"A-1\", \"Widget\", \"--qty\", \"3\")","+        self.run_cli(\"add\", \"B-2\", \"Gadget\")","+        code, text = self.run_cli(\"count\")","+        self.assertEqual(code, 0)","+        self.assertEqual(text, \"2\\n\")"," ","+    def test_count_empty_store_is_zero(self):","+        code, text = self.run_cli(\"count\")","+        self.assertEqual(code, 0)","+        self.asser